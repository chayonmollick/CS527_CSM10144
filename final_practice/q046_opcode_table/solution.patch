+/* Q046: name of each opcode (index = opcode), for the table below */
+static const char *OP_NAME[0x34] = {
+    "halt", "add", "sub", "mul", "div", "load", "store", "mov",          /* 00-07 */
+    "print", "addi", "subi", "muli", "divi", "loadc", "storec", "movc",  /* 08-0F */
+    "beq", "bne", "bcs", "bcc", "bmi", "bpl", "bvs", "bvc",              /* 10-17 */
+    "bhi", "bls", "bge", "blt", "bgt", "ble", "bal", "",                 /* 18-1F */
+    "", "vadd", "vsub", "vmul", "", "vload", "vstore", "",               /* 20-27 */
+    "", "vaddi", "vsubi", "vmuli", "vloadc", "", "vstorec", "",          /* 28-2F */
+    "", "vaddx", "vsubx", "vmulx"};                                      /* 30-33 */
+
+/* Q046: table of the instructions the task executed, per opcode (printed when it ends) */
+static void print_opcode_table(int p, const Task &t) {
+    std::printf("[opcodes] pid %d (%s): executed instructions per opcode\n", t.pid, t.prog.name.c_str());
+    std::printf("    opcode  name      count\n");
+    long total = 0;
+    for (int op = 0; op < 256; op++) {
+        if (op_count[p][op] == 0) continue;
+        std::printf("    %02X      %-8s %6ld\n", op, op < 0x34 && OP_NAME[op][0] ? OP_NAME[op] : "?", op_count[p][op]);
+        total += op_count[p][op];
+    }
+    std::printf("    total            %6ld\n", total);
+}
+
 /* finalize(): write the data back, write the frequency report, free the frames. */
