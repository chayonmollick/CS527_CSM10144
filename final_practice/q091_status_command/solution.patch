+/* Q091: status - round number, tasks per state, free frames, busy processors */
+static void status() {
+    int finished = 0, running = 0, waiting = 0, busy = 0;
+    for (const Task &t : tasks) {
+        if (t.state == DONE) finished++;
+        else if (t.state == READY) running++;
+        else waiting++;
+    }
+    for (int p = 0; p < NP; p++) busy += proc_owner[p] != 0;
+    std::printf("[status] round %d: %d finished, %d running, %d waiting; %d of %d frames free; %d of %d processors busy:",
+                round_no, finished, running, waiting, free_page_count(), NUM_PHYSICAL_PAGES - 1, busy, NP);
+    for (int p = 0; p < NP; p++) {
+        if (proc_owner[p]) std::printf(" p%d=pid%d", p, proc_owner[p]);
+        else std::printf(" p%d=free", p);
+    }
+    std::printf("\n");
+}
