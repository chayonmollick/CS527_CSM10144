+
+/* Q099: ./sim -k N. In a simulation each thread runs only 10 instructions between usleeps,
+ * so the cost of counting is hidden. Here every thread counts N times in a tight loop, each
+ * way on its own. volatile makes every +1 a real memory update, as in execute(). */
+void count_benchmark(long n) {
+    int threads = omp_get_max_threads();
+    volatile long unprotected = 0;
+    long by_critical = 0, by_atomic = 0, by_proc_sum = 0;
+    std::vector<long> by_proc(8 * threads, 0);           /* one per thread, 64 bytes apart */
+    #pragma omp parallel                                 /* start the threads before timing */
+    { }
+    double t0 = omp_get_wtime();
+    #pragma omp parallel
+    for (long i = 0; i < n; i++) unprotected = unprotected + 1;     /* data race */
+    double t1 = omp_get_wtime();
+    #pragma omp parallel
+    for (long i = 0; i < n; i++) {
+        #pragma omp critical(count)
+        by_critical++;
+    }
+    double t2 = omp_get_wtime();
+    #pragma omp parallel
+    for (long i = 0; i < n; i++) {
+        #pragma omp atomic
+        by_atomic++;
+    }
+    double t3 = omp_get_wtime();
+    #pragma omp parallel
+    {
+        volatile long *mine = &by_proc[8 * omp_get_thread_num()];
+        for (long i = 0; i < n; i++) *mine = *mine + 1;
+    }
+    for (long c : by_proc) by_proc_sum += c;             /* summed at the end, like a reduction */
+    double t4 = omp_get_wtime();
+    long total = n * threads;
+    std::printf("counting benchmark: %d thread(s) x %ld = %ld increments each way\n", threads, n, total);
+    std::printf("  no protection   %10ld  %-5s %9.3f ms\n", (long)unprotected,
+                unprotected == total ? "" : "WRONG", (t1 - t0) * 1e3);
+    std::printf("  critical        %10ld  %-5s %9.3f ms\n", by_critical, "", (t2 - t1) * 1e3);
+    std::printf("  atomic          %10ld  %-5s %9.3f ms\n", by_atomic, "", (t3 - t2) * 1e3);
+    std::printf("  per-processor   %10ld  %-5s %9.3f ms\n", by_proc_sum, "", (t4 - t3) * 1e3);
 }
