     return n;
 }
 
-int create_task(const std::string &program, const std::string &data) {
-    if (tasks.size() >= MAX_TASKS) { std::printf("[os] process table full (%d tasks)\n", MAX_TASKS); return -1; }
+/* Q096: a task before it gets a pid. prepare() reads its own two files and writes only its
+ * own Prepared, so several prepare() calls can run at the same time. */
+struct Prepared {
     Task t;
-    t.pid = (int)tasks.size() + 1;
+    bool compiled = false;                  /* compiled from source: program.byte to write */
+    bool ok = false;
+    std::string err;
+};
+
+static void prepare(const std::string &program, const std::string &data, Prepared &pr) {
+    Task &t = pr.t;
+    std::string &err = pr.err;
     t.program_path = program;
     t.data_path = data;
-    std::string err;
     bool is_bytecode = program.size() > 5 && program.compare(program.size() - 5, 5, ".byte") == 0;
     bool ok = is_bytecode ? load_bytecode(program, t.prog, err) : compile_file(program, t.prog, err);
-    if (ok && !is_bytecode) write_program_byte("program.byte", t.prog);     /* compiled code, as in Lab 1 */
+    pr.compiled = ok && !is_bytecode;       /* Q096: program.byte is written later, in commit() */
     if (ok) ok = read_byte_file(data, t.data, err);
     if (ok && t.data.size() > (size_t)DATA_SPACE) { err = data + " is larger than the data space (" + std::to_string(DATA_SPACE) + " bytes)"; ok = false; }
     if (ok && pages_for(t.prog.code.size()) + pages_for(t.data.size()) > NUM_PHYSICAL_PAGES - 1) { err = "task needs more frames than physical memory has"; ok = false; }
-    if (!ok) { std::printf("[os] cannot start task: %s\n", err.c_str()); return -1; }
+    pr.ok = ok;
+}
 
+/* Q096: the part that touches shared state, so it runs serially in command-line order: the
+ * pid, program.byte (one file for everyone), the messages, the process table, the loader. */
+static int commit(Prepared &pr) {
+    if (tasks.size() >= MAX_TASKS) { std::printf("[os] process table full (%d tasks)\n", MAX_TASKS); return -1; }
+    Task &t = pr.t;
+    if (pr.compiled) write_program_byte("program.byte", t.prog);     /* compiled code, as in Lab 1 */
+    if (!pr.ok) { std::printf("[os] cannot start task: %s\n", pr.err.c_str()); return -1; }
+    t.pid = (int)tasks.size() + 1;
     tasks.push_back(t);
     waiting_queue.push_back(t.pid);
-    std::printf("[os] pid %d created: %s %s (%zu instructions)\n", t.pid, program.c_str(), data.c_str(), t.prog.code.size() / 4);
+    std::printf("[os] pid %d created: %s %s (%zu instructions)\n", t.pid, t.program_path.c_str(), t.data_path.c_str(), t.prog.code.size() / 4);
     admit_waiting();
     if (tasks.back().state == WAITING) std::printf("[os] pid %d is waiting for a free processor/frames\n", t.pid);
     return t.pid;
+}
+
+int create_task(const std::string &program, const std::string &data) {   /* Q096: the shell, one task */
+    Prepared pr;
+    prepare(program, data, pr);
+    return commit(pr);
+}
+
+int create_tasks(const std::vector<std::string> &args) {
+    std::vector<Prepared> list(args.size() / 2);      /* Q096: one slot per task */
+    double start = omp_get_wtime();
+    #pragma omp parallel for schedule(dynamic, 1)     /* Q096: programs differ in size */
+    for (size_t k = 0; k < list.size(); k++)
+        prepare(args[2 * k], args[2 * k + 1], list[k]);
+    if (!list.empty())
+        std::fprintf(stderr, "[os] %zu program(s) compiled in %.3f ms with %d thread(s)\n",
+                     list.size(), (omp_get_wtime() - start) * 1e3, omp_get_max_threads());
+    int bad = 0;
+    for (Prepared &pr : list)                         /* Q096: serial, in command-line order */
+        if (commit(pr) < 0) bad++;
+    return bad;
 }
 
