diff -ruN a/os.cpp b/os.cpp
--- a/os.cpp	2026-11-12 11:07:56
+++ b/os.cpp	2026-11-12 11:07:56
@@ -47,6 +47,8 @@
 static int page_faults_on[NP];
 static bool shell_open = true;
 static std::string shell_buffer;
+static const int SHARED_PAGE = NUM_DATA_PAGES - 1;  /* Q087: data page 7 (addresses 3584..4095) is shared */
+static int shared_frame;                            /* Q087: the one frame behind it, in every page table */
 
 static int pages_for(size_t bytes) { return (int)((bytes + PAGESIZE - 1) / PAGESIZE); }
 
@@ -109,6 +111,7 @@
     std::memset(&memory[PTBR[p]], 0, NUM_LOGICAL_PAGES);   /* all pages unmapped */
