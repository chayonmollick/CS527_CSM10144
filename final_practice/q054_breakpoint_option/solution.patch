diff -ruN a/processor.cpp b/processor.cpp
--- a/processor.cpp	2026-11-12 11:24:20
+++ b/processor.cpp	2026-11-12 11:24:20
@@ -26,9 +26,29 @@
 int proc_id, opcode, dest, src1, src2;
 FILE *fd_log = nullptr;
 int trace = 0;
+int break_at = -1;                              /* Q054: set by -k N */
 
 static int instr_pc;     /* address of the instruction being executed (PC already points past it) */
+static bool break_done[NP];   /* Q054: breakpoint already reported for the task on p */
 
+/* Q054: first time instruction break_at runs in a task: show its non-zero registers (before it executes) */
+static void breakpoint(int p) {
+    break_done[p] = true;
+    std::printf("[break] pid %d, instruction %d (%s), registers before it runs:", current_pid[p], instr_pc / 4,
+                disassemble(opcode, dest, src1, src2).c_str());
+    for (int r = 0; r < NUM_XREGS; r++)
+        if (Register[p][r] != 0) std::printf(" x%d=%d", r, Register[p][r]);
+    for (int r = 0; r < NUM_VREGS; r++) {
+        bool nonzero = false;
+        for (int i = 0; i < VLEN; i++) if (VRegister[p][r][i] != 0) nonzero = true;
+        if (!nonzero) continue;
+        std::printf(" v%d=[", r);
+        for (int i = 0; i < VLEN; i++) std::printf("%s%d", i ? " " : "", VRegister[p][r][i]);
+        std::printf("]");
+    }
+    std::printf("\n");
+}
