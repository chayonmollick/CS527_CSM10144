+    }
+    const int *va = VRegister[p][src1];
+    int *vd = VRegister[p][dest];
+#ifdef Q097_LANE_THREADS
+    #pragma omp parallel for        /* Q097 experiment only (-DQ097_LANE_THREADS): threads per lane */
+#else
+    #pragma omp simd                /* Q097: the 8 lanes are independent: one SIMD instruction does several */
+#endif
     for (int i = 0; i < VLEN; i++) {
-        uint32_t a = (uint32_t)VRegister[p][src1][i];
