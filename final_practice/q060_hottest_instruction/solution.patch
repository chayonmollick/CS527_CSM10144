                 t.pid, t.prog.name.c_str(), t.failed ? "STOPPED WITH AN ERROR" : "finished", p,
                 t.steps, t.page_faults, out_name.c_str(), freq_name.c_str());
+    print_hottest(p, t);                                   /* Q060: most executed instruction */
 }
 
