+/* Q025: how many instructions a line compiles to (pass 1 needs it: labels count instructions) */
+static int line_size(const std::vector<std::string> &t) {
+    return (!t.empty() && lower(t[0]) == "swap") ? 3 : 1;
+}
+
+/* Q025: swap xA xB -> xA = xA + xB; xB = xA - xB; xA = xA - xB  (no spare register; sets the flags) */
+static bool encode_swap(const std::vector<std::string> &t, unsigned char ins[3][4], std::string &msg) {
+    Operand a, b;
+    size_t i = 1;
+    if (t.size() != 3 || !parse_operand(t, i, a, msg) || !parse_operand(t, i, b, msg)
+        || a.kind != Operand::XREG || b.kind != Operand::XREG || a.value == b.value) {
+        msg = "usage: swap xA xB (two different x registers)";
+        return false;
+    }
+    set(ins[0], OP_ADD, a.value, a.value, b.value);             /* xA = a + b */
+    set(ins[1], OP_SUB, b.value, a.value, b.value);             /* xB = (a + b) - b = a */
+    set(ins[2], OP_SUB, a.value, a.value, b.value);             /* xA = (a + b) - a = b */
+    return true;
+}
