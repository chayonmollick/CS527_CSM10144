diff -ruN a/config.h b/config.h
--- a/config.h	2026-11-12 11:24:38
+++ b/config.h	2026-11-12 11:24:38
@@ -28,6 +28,11 @@
 #define MAX_STEPS       10000000L  /* a task that runs longer is killed (endless loop guard) */
 #define LOG_FILE        "log.txt"  /* print output (Lab 4), opened in append mode */
 
+/* Q059: timing model, in cycles */
+#define CYCLES_PER_INSTRUCTION 1     /* every executed instruction */
+#define CYCLES_PER_MEM_WORD    2     /* extra per 32-bit data word read or written (a vector access = 8 words) */
+#define CYCLES_PER_PAGE_FAULT  100   /* extra per page fault */
+
 /* ---- opcodes (first byte of every 4-byte instruction) ----
  * Format: <opcode> <dest> <operand1> <operand2>. "c" = constant 0..255.
  */
diff -ruN a/os.cpp b/os.cpp
--- a/os.cpp	2026-11-12 11:24:38
+++ b/os.cpp	2026-11-12 11:24:38
@@ -167,6 +167,11 @@
     std::printf("[os] pid %d (%s) %s on processor %d after %ld instructions, %d page fault(s) -> %s, %s\n",
                 t.pid, t.prog.name.c_str(), t.failed ? "STOPPED WITH AN ERROR" : "finished", p,
                 t.steps, t.page_faults, out_name.c_str(), freq_name.c_str());
+    long cycles = t.steps * CYCLES_PER_INSTRUCTION + mem_words[p] * CYCLES_PER_MEM_WORD
+                + (long)t.page_faults * CYCLES_PER_PAGE_FAULT;                       /* Q059: timing model */
+    std::printf("[time] pid %d (%s): %ld cycles = %d x %ld instructions + %d x %ld memory words + %d x %d faults\n",
+                t.pid, t.prog.name.c_str(), cycles, CYCLES_PER_INSTRUCTION, t.steps,
+                CYCLES_PER_MEM_WORD, mem_words[p], CYCLES_PER_PAGE_FAULT, t.page_faults);
 }
 
