 static std::vector<Task> tasks;             /* tasks[pid - 1] */
@@ -207,6 +208,27 @@
     int n = 0;
     for (const Task &t : tasks) n += t.failed;
     return n;
+}
+
+/* Q088: message passing. A receiver blocked in recv gets the value at once, else it is queued. */
+bool os_send(int pid, int value) {
+    if (pid < 1 || pid > (int)tasks.size()) return false;
+    Task &t = tasks[pid - 1];
+    if (t.proc >= 0 && recv_reg[t.proc] >= 0) {        /* blocked in xD = recv: fill xD, unblock */
+        Register[t.proc][recv_reg[t.proc]] = value;
+        recv_reg[t.proc] = -1;
+    } else {
+        t.mailbox.push_back(value);
+    }
+    return true;
+}
+
+bool os_recv(int pid, int &value) {                     /* Q088 */
+    std::deque<int> &box = tasks[pid - 1].mailbox;
+    if (box.empty()) return false;
+    value = box.front();
+    box.pop_front();
+    return true;
 }
 
