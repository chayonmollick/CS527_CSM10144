diff -ruN a/processor.cpp b/processor.cpp
--- a/processor.cpp	2026-11-12 11:24:20
+++ b/processor.cpp	2026-11-12 11:24:20
@@ -26,6 +26,7 @@
 int proc_id, opcode, dest, src1, src2;
 FILE *fd_log = nullptr;
 int trace = 0;
+int watch_addr = -1;                            /* Q053: set by -w ADDR */
 
 static int instr_pc;     /* address of the instruction being executed (PC already points past it) */
 
@@ -76,12 +77,18 @@
 
 static bool store_word(int addr, int value) {
     unsigned int v = (unsigned int)value;
+    int old = 0;
+    bool watched = watch_addr >= 0 && addr <= watch_addr && watch_addr < addr + 4;   /* Q053: this word covers ADDR */
+    if (watched && !load_word(addr, old)) return false;                              /* Q053: value before the write */
     for (int k = 0; k < 4; k++) {
         int pa = getPhysicalAddress(proc_id, 0, addr + k);
         if (pa < 0) return false;
         memory[pa] = (unsigned char)(v >> (8 * k));
     }
     if (addr + 4 > data_high[proc_id]) data_high[proc_id] = addr + 4;
+    if (watched)                                                                     /* Q053: report the write */
+        std::printf("[watch] pid %d, instruction %d (%s): [%d] %d -> %d\n", current_pid[proc_id], instr_pc / 4,
+                    disassemble(opcode, dest, src1, src2).c_str(), addr, old, value);
     return true;
 }
 
