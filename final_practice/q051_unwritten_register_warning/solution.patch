+static bool xknown[NP][NUM_XREGS];   /* Q051: x register written by the task (or already warned about) */
 
+/* Q051: the instruction reads x<r>: warn once if the task never wrote it */
+static void check_read(int p, int r) {
+    if (xknown[p][r]) return;
+    xknown[p][r] = true;                                 /* warn only once per register */
+    std::fprintf(stderr, "[warn] pid %d reads x%d before writing it, at %s\n", current_pid[p], r,
+                 source_line(p, instr_pc / 4).c_str());
+}
