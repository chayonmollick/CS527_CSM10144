+/* Q051: "line 3: x2 = x1 + x5" for instruction index of the task running on processor p */
+std::string source_line(int p, int index) {
+    const Program &pr = tasks[current_pid[p] - 1].prog;
+    int ln = index < (int)pr.line_of.size() ? pr.line_of[index] : -1;
+    if (ln < 0) return "instruction " + std::to_string(index) + " (no source)";
+    const std::string &text = pr.source[ln];
+    return "line " + std::to_string(ln + 1) + ": " + text.substr(text.find_first_not_of(" \t"));
+}
