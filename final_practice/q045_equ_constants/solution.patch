+/* Q045: a constant's name starts with a letter and is not a register name such as x5 or v2. */
+static bool is_name(const std::string &w) {
+    if (w.empty() || !std::isalpha((unsigned char)w[0])) return false;
+    char c0 = (char)std::tolower((unsigned char)w[0]);
+    return !((c0 == 'x' || c0 == 'v') && all_digits(w.substr(1)));
+}
