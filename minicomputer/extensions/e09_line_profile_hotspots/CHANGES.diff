+            std::fprintf(f, "%5zu %8ld %8ld %8.2f  %s\n", i, exec_count[p][i], exec_cycles[p][i], exec_cycles[p][i] * pct, text.c_str());
+            rows.push_back({(int)i, exec_count[p][i], exec_cycles[p][i], text});
+        }
+    }
+    if (n > 0)
+        std::fprintf(f, "%5s %8ld %8ld %8.2f  %s\n", "-", exec_count[p][n - 1], exec_cycles[p][n - 1],
+                     exec_cycles[p][n - 1] * pct, "(halt at the end of the program)");
+
+    std::vector<ProfRow> hot = rows;                               /* most cycles first; ties: in line order */
+    std::stable_sort(hot.begin(), hot.end(), [](const ProfRow &a, const ProfRow &b) { return a.cycles > b.cycles; });
+    std::fprintf(f, "\ntop %d hottest %s (most cycles first):\n", PROF_TOP, pr.has_source ? "lines" : "instructions");
+    std::fprintf(f, "%4s %5s %8s %8s %8s  %s\n", "rank", pr.has_source ? "line" : "instr", "cycles", "%cycles", "count",
