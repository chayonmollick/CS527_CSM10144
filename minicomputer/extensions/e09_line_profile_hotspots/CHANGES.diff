+/* EXT e09: one row of the line profile: a source line with code (or, for a task started
+ * from a .byte file, one instruction), its executions and its estimated cycles. */
+struct ProfRow {
+    int where;                  /* source line number (1-based), or instruction index */
+    long count, cycles;
+    std::string text;           /* source line without leading/trailing blanks, or disassembly */
+};
