+static int latency(int op, int taken) {
+    switch (op) {
+    case OP_ADD: case OP_SUB: case OP_ADDI: case OP_SUBI:
+    case OP_MOV: case OP_MOVC:                      return LAT_ALU;
+    case OP_MUL: case OP_MULI:                      return LAT_MUL;
+    case OP_DIV: case OP_DIVI:                      return LAT_DIV;
+    case OP_LOAD: case OP_LOADC:                    return LAT_LOAD;
+    case OP_STORE: case OP_STOREC:                  return LAT_STORE;
+    case OP_PRINT:                                  return LAT_PRINT;
+    case OP_HALT:                                   return LAT_HALT;
