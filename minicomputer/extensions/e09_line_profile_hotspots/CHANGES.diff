+    long total = 0, executed = 0;
+    for (size_t i = 0; i < n; i++) { total += exec_cycles[p][i]; executed += exec_count[p][i]; }
+    double pct = total ? 100.0 / total : 0.0;                      /* % of all cycles per cycle */
+    std::string name = t.prog.name + "_" + std::to_string(t.pid) + ".prof";
+    FILE *f = std::fopen(name.c_str(), "w");
+    if (!f) return "(could not write " + name + ")";
+    std::fprintf(f, "Line profile of %s (pid %d): %ld instructions executed, %ld estimated cycles\n",
+                 pr.name.c_str(), t.pid, executed, total);
+    std::fprintf(f, "%5s %8s %8s %8s  %s\n", pr.has_source ? "line" : "instr", "count", "cycles", "%cycles",
+                 pr.has_source ? "source" : "instruction");
+    std::vector<ProfRow> rows;                                     /* rows with code, in order */
+    if (pr.has_source) {
+        std::vector<long> count(pr.source.size(), 0), cycles(pr.source.size(), 0);
+        std::vector<bool> code(pr.source.size(), false);
+        for (size_t i = 0; i < n; i++)
+            if (pr.line_of[i] >= 0) {
+                count[pr.line_of[i]] += exec_count[p][i];
+                cycles[pr.line_of[i]] += exec_cycles[p][i];
+                code[pr.line_of[i]] = true;
+            }
+        for (size_t ln = 0; ln < pr.source.size(); ln++) {        /* same lines as the .freq file */
+            std::string text = pr.source[ln];
+            while (!text.empty() && (text.back() == ' ' || text.back() == '\t')) text.pop_back();
+            if (code[ln]) {
+                std::fprintf(f, "%5zu %8ld %8ld %8.2f  %s\n", ln + 1, count[ln], cycles[ln], cycles[ln] * pct, text.c_str());
+                rows.push_back({(int)ln + 1, count[ln], cycles[ln], strip(text)});
+            } else if (pr.is_label[ln]) {
