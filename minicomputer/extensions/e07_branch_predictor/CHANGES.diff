+/* EXT e07: source text of instruction i without its comment (disassembly if there is no source) */
+static std::string branch_text(const Program &pr, size_t i) {
+    if (!pr.has_source || pr.line_of[i] < 0)
+        return disassemble(pr.code[4 * i], pr.code[4 * i + 1], pr.code[4 * i + 2], pr.code[4 * i + 3]);
+    std::string s = pr.source[pr.line_of[i]];
+    s = s.substr(0, s.find('%'));
+    size_t b = s.find_first_not_of(" \t"), e = s.find_last_not_of(" \t");
+    return b == std::string::npos ? "" : s.substr(b, e - b + 1);
+}
