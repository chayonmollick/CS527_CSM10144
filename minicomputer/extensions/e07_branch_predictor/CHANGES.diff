+/* EXT e07: every predictor guesses the branch at instruction index (offset = its jump
+ * in instructions), is scored against the real outcome, then learns the outcome. */
+static void predict_branch(int p, int index, int offset, int taken) {
+    int e = index % BP_TABLE_SIZE;                   /* predictor table entry of this branch */
+    int guess[NUM_PREDICTORS];
+    guess[PRED_ALWAYS_TAKEN] = 1;
+    guess[PRED_BTFN] = offset <= 0;                  /* backward = loop branch: taken */
+    guess[PRED_1BIT] = bp_last[p][e];                /* same outcome as last time */
+    guess[PRED_2BIT] = bp_counter[p][e] >= 2;        /* 2, 3 predict taken; 0, 1 not taken */
+    bp_branches[p]++;
+    bp_taken[p] += taken;
+    bp_taken_at[p][index] += taken;
+    for (int k = 0; k < NUM_PREDICTORS; k++)
+        if (guess[k] != taken) { bp_miss[p][k]++; bp_miss_at[p][index][k]++; }
+    bp_last[p][e] = (unsigned char)taken;            /* learn the outcome */
+    if (taken && bp_counter[p][e] < 3) bp_counter[p][e]++;
+    else if (!taken && bp_counter[p][e] > 0) bp_counter[p][e]--;
+}
