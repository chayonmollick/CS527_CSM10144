+/* ---- EXT e07: branch prediction ----
+ * Four predictors guess every executed branch (BAL too: its outcome is always taken):
+ *   always-taken | btfn: backward (offset <= 0) taken, forward not taken |
+ *   1-bit: same as last time | 2-bit: saturating counter 0..3, predict taken if >= 2.
+ * The dynamic ones keep one entry per branch, indexed by instruction index % BP_TABLE_SIZE;
+ * the tables are reset to the INIT values whenever a task is loaded on the processor.
+ */
+#define BP_TABLE_SIZE   MAX_INSTRUCTIONS   /* EXT e07: 256 entries, so no two branches share one */
+#define BP_1BIT_INIT    0       /* EXT e07: 1-bit entry at load time: 0 = not taken, 1 = taken */
+#define BP_2BIT_INIT    1       /* EXT e07: 0 strongly NT, 1 weakly NT, 2 weakly T, 3 strongly T */
+
+enum Predictor { PRED_ALWAYS_TAKEN, PRED_BTFN, PRED_1BIT, PRED_2BIT, NUM_PREDICTORS };   /* EXT e07 */
+
