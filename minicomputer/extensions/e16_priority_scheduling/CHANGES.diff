+/* ---- scheduling policy (EXT e16) ----
+ * ROUND_ROBIN: Lab 4 - tasks are admitted and run in arrival order.
+ * PRIORITY   : the higher priority (shell/command line: "prog.txt data.byte 3") is admitted
+ *              first and runs first in every round; equal priorities keep arrival order.
+ * SJF        : shortest job first = fewest program instructions; non-preemptive: a loaded
+ *              task keeps its processor, the choice is made when a processor becomes free.
+ * Change SCHED_POLICY here (or build with -DSCHED_POLICY=SJF); ./sim -s rr|priority|sjf overrides it. */
+enum SchedPolicy { ROUND_ROBIN, PRIORITY, SJF };   /* EXT e16 */
+#ifndef SCHED_POLICY
+#define SCHED_POLICY    ROUND_ROBIN               /* EXT e16: default = the Lab 4 behaviour */
+#endif
