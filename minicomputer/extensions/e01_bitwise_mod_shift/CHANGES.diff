+/* EXT e01: arithmetic shift right (bit 31 is copied in from the left), written so that it does not
+ * depend on how the C++ compiler shifts a negative int (implementation-defined before C++20):
+ * for v < 0, ~v is >= 0, so shift ~v and flip the bits back. -100 >> 2 = -25. */
+static int shift_right_arith(int v, uint32_t n) {
+    if (n >= 32) return v < 0 ? -1 : 0;                  /* every bit shifted out: only sign bits left */
+    return v < 0 ? ~(~v >> n) : v >> n;
+}
