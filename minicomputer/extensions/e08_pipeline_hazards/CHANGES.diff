+static std::string write_pipeline_file(int p, const Task &t, long &cycles_nofwd, long &cycles_fwd) {
+    const PipeStats &s = pipe_stats[p];
+    long penalty = PIPE_BRANCH_PENALTY * s.taken_branches;
+    cycles_nofwd = PIPE_FILL + s.instructions + s.stalls_nofwd + penalty;
+    cycles_fwd = PIPE_FILL + s.instructions + s.stalls_fwd + penalty;
+    std::string name = t.prog.name + "_" + std::to_string(t.pid) + ".pipe";
+    FILE *f = std::fopen(name.c_str(), "w");
+    if (!f) return "(could not write " + name + ")";
+    double n = s.instructions ? (double)s.instructions : 1.0;
+    std::fprintf(f, "5-stage pipeline (IF ID EX MEM WB) for %s (pid %d)\n", t.prog.name.c_str(), t.pid);
+    std::fprintf(f, "instructions     %6ld\n", s.instructions);
+    std::fprintf(f, "taken_branches   %6ld   (%d flushed cycles each)\n", s.taken_branches, PIPE_BRANCH_PENALTY);
+    std::fprintf(f, "raw_hazards_d1   %6ld   (reader right after the writer)\n", s.raw_d1);
+    std::fprintf(f, "raw_hazards_d2   %6ld   (one instruction in between)\n", s.raw_d2);
+    std::fprintf(f, "load_use         %6ld   (d1 hazards on a loaded register)\n\n", s.load_use);
+    std::fprintf(f, "%-19s %7s %8s %7s %6s\n", "", "stalls", "penalty", "cycles", "CPI");
+    std::fprintf(f, "%-19s %7ld %8ld %7ld %6.2f\n", "without_forwarding", s.stalls_nofwd, penalty, cycles_nofwd, cycles_nofwd / n);
+    std::fprintf(f, "%-19s %7ld %8ld %7ld %6.2f\n", "with_forwarding", s.stalls_fwd, penalty, cycles_fwd, cycles_fwd / n);
+    std::fprintf(f, "cycles = %d + instructions + stalls + %d x taken branches\n\n", PIPE_FILL, PIPE_BRANCH_PENALTY);
