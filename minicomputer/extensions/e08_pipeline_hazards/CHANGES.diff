+/* ---- EXT e08: classic 5-stage in-order pipeline model (IF ID EX MEM WB) ----
+ * The executed instruction stream of each task is replayed on two pipelines, one
+ * without and one with forwarding. Registers are read in ID and written in WB (first
+ * half of the cycle, so an ID in the same cycle reads the new value). Branches are
+ * resolved in EX; the flags (NZCV) are forwarded to EX and never cause a stall.
+ *   cycles = PIPE_FILL + instructions + stalls + PIPE_BRANCH_PENALTY * taken branches
+ */
+#define PIPE_FILL            4   /* EXT e08: the first instruction leaves WB in cycle 5 */
+#define PIPE_BRANCH_PENALTY  2   /* EXT e08: a taken branch flushes the 2 instructions fetched after it */
+#define PIPE_NOFWD_GAP       3   /* EXT e08: no forwarding: reader's ID >= writer's ID + 3 (the writer's WB) */
+#define PIPE_LOAD_GAP        2   /* EXT e08: forwarding: reader's ID >= load's ID + 2 (value ready after MEM) */
+#define PIPE_LOG_ROWS        40  /* EXT e08: executed instructions listed one by one in the .pipe file */
+
 #endif
