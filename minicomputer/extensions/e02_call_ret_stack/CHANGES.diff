+ * so they go through the MMU: the stack page gets a frame on its first push, like any data page. ---- */
+
+static bool push_word(int value) {
+    int p = proc_id;
+    if (SP[p] - 4 < DATA_SPACE - STACK_SIZE) {
+        processor_error("stack overflow: more than %d bytes pushed (endless recursion?)", STACK_SIZE);
+        return false;
+    }
+    int high = data_high[p];
+    if (!store_word(SP[p] - 4, value)) return false;
+    data_high[p] = high;                         /* stack words are not program data: keep the .out size */
+    SP[p] -= 4;
+    if (SP[p] < stack_low[p]) stack_low[p] = SP[p];
+    return true;
+}
+
+static bool pop_word(int &value) {
+    int p = proc_id;
+    if (SP[p] >= DATA_SPACE) {
+        processor_error("stack underflow: pop or ret with an empty stack");
+        return false;
+    }
+    if (!load_word(SP[p], value)) return false;
+    SP[p] += 4;
