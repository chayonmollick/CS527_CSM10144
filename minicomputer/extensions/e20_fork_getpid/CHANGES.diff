+/* EXT e20: copy the registers of processor p out (fork) and back in (starting the child). */
+void save_cpu(int p, CpuState &s) {
+    std::memcpy(s.x, Register[p], sizeof s.x);
+    std::memcpy(s.v, VRegister[p], sizeof s.v);
+    s.pc = PC[p];                                /* already points past the fork instruction */
+    s.flagN = FlagN[p]; s.flagZ = FlagZ[p]; s.flagC = FlagC[p]; s.flagV = FlagV[p];
+    s.data_high = data_high[p];
+}
+
+void load_cpu(int p, const CpuState &s) {
+    std::memcpy(Register[p], s.x, sizeof s.x);
+    std::memcpy(VRegister[p], s.v, sizeof s.v);
+    PC[p] = s.pc;
+    FlagN[p] = s.flagN; FlagZ[p] = s.flagZ; FlagC[p] = s.flagC; FlagV[p] = s.flagV;
+    data_high[p] = s.data_high;
+}
