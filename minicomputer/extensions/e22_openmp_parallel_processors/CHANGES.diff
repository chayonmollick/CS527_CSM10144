-# CS527 mini-computer simulator (Labs 1-6)
-#   make                 build ./sim
-#   make test            build and run the regression tests (../tests/run_tests.sh)
-#   ./sim -b ../examples/sum_array.txt ../examples/sum_array_data.byte
+# CS527 mini-computer simulator, EXT e22: processors run in parallel with OpenMP.
+#   make            build ./sim (g++ -fopenmp on Linux; Homebrew g++ or clang+libomp on macOS)
+#   ./test.sh       build and run the checks
 CXX      ?= g++
 CXXFLAGS ?= -std=c++17 -O2 -Wall -Wextra
 OBJS = main.o compiler.o processor.o memory.o os.o
 HDRS = config.h compiler.h memory.h os.h processor.h
 
+# EXT e22: find a C++ compiler with OpenMP (Apple's clang++ has none built in).
+OMP_NATIVE := $(shell printf 'int main(){return 0;}' | $(CXX) -fopenmp -x c++ - -o /dev/null >/dev/null 2>&1 && echo 1)
+BREW_GXX   := $(shell ls /opt/homebrew/bin/g++-[0-9]* /usr/local/bin/g++-[0-9]* 2>/dev/null | head -1)
+ifeq ($(OMP_NATIVE),1)
+  OMPFLAGS := -fopenmp
+  OMPLIBS  := -fopenmp
+else ifneq ($(BREW_GXX),)
+  CXX      := $(BREW_GXX)
+  OMPFLAGS := -fopenmp
+  OMPLIBS  := -fopenmp
+else
+  LIBOMP   := $(shell brew --prefix libomp 2>/dev/null)
+  OMPFLAGS := -Xpreprocessor -fopenmp -I$(LIBOMP)/include
+  OMPLIBS  := -L$(LIBOMP)/lib -lomp
+endif
+
 sim: $(OBJS)
-	$(CXX) $(CXXFLAGS) -o $@ $(OBJS)
+	$(CXX) $(CXXFLAGS) -o $@ $(OBJS) $(OMPLIBS)
 
 %.o: %.cpp $(HDRS)
-	$(CXX) $(CXXFLAGS) -c $<
+	$(CXX) $(CXXFLAGS) $(OMPFLAGS) -c $<
 
-test: sim
-	cd ../tests && ./run_tests.sh
-
 clean:
 	rm -f sim $(OBJS) program.byte *.out *.freq log.txt
 
