 /* ---------------- memory management unit ---------------- */
+
+/* EXT e11: translation look-aside buffer (TLB). Every processor has its own TLB (it is
+ * hardware, like PTBR). An entry caches one page-table entry: logical page index (the
+ * page-table index 0..NUM_LOGICAL_PAGES-1, instruction and data pages) -> frame.
+ * Fully associative: a page may sit in any entry, so a lookup compares all entries.
+ * Replacement: least recently used (the entry with the oldest time stamp). */
+struct TlbEntry {
+    bool valid = false;
+    int page = 0;                           /* logical page index */
+    int frame = 0;                          /* physical frame */
+    long last_used = 0;                     /* time of the last hit or fill (LRU) */
+};
+static TlbEntry tlb[NP][TLB_ENTRIES];
+static long tlb_clock[NP];                  /* EXT e11: counts TLB lookups; gives the LRU time stamps */
+static long tlb_hits[NP][2], tlb_misses[NP][2];   /* EXT e11: [p][0] = data accesses, [p][1] = fetches */
+
+static void tlb_flush(int p) {              /* EXT e11: forget every translation of processor p */
+    for (int e = 0; e < TLB_ENTRIES; e++) tlb[p][e].valid = false;
+}
+
+/* EXT e11: frame of logical page index, or -1 if the TLB does not hold it (a miss). */
+static int tlb_lookup(int p, int index) {
+    for (int e = 0; e < TLB_ENTRIES; e++)
+        if (tlb[p][e].valid && tlb[p][e].page == index) {
+            tlb[p][e].last_used = ++tlb_clock[p];  /* hit: now the most recently used */
+            return tlb[p][e].frame;
+        }
+    return -1;
