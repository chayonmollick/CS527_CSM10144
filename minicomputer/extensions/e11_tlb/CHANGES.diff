+static void tlb_insert(int p, int index, int frame) {
+    int victim = 0;
+    for (int e = 0; e < TLB_ENTRIES; e++) {
+        if (!tlb[p][e].valid) { victim = e; break; }               /* free entry: take it */
+        if (tlb[p][e].last_used < tlb[p][victim].last_used) victim = e;
+    }
+    tlb[p][victim].valid = true;
+    tlb[p][victim].page = index;
+    tlb[p][victim].frame = frame;
+    tlb[p][victim].last_used = ++tlb_clock[p];
+}
 
