+/* ---------------- memory map (EXT e15) ---------------- */
+
+/* EXT e15: print the memory map: every frame with its owner, then every processor's page
+ * table read from frame 0 through PTBR, then the free-frame count.
+ * Whether a frame is used comes from the OS free list (freePages); who uses it is found by
+ * searching all page tables. A used frame must appear in exactly one page table and a free
+ * frame in none; anything else is printed as INCONSISTENT. Returns the number of problems. */
+static int dump_memory_map(FILE *f, const std::string &title) {
+    int problems = 0;
+    std::fprintf(f, "=== memory map: %s ===\n", title.c_str());
+    std::fprintf(f, "frame  0  reserved: page tables (processor p at bytes %d*p .. %d*p+%d)\n",
+                 NUM_LOGICAL_PAGES, NUM_LOGICAL_PAGES, NUM_LOGICAL_PAGES - 1);
+    for (int fr = 1; fr < NUM_PHYSICAL_PAGES; fr++) {
+        int count = 0, proc = -1, index = -1;               /* page-table entries that map fr */
+        for (int p = 0; p < NP; p++) {
+            if (PTBR[p] < 0) continue;
+            for (int i = 0; i < NUM_LOGICAL_PAGES; i++)
+                if (memory[PTBR[p] + i] == fr) { count++; proc = p; index = i; }
+        }
+        if (freePages[fr] && count == 1) {
+            bool code = index < NUM_INSTR_PAGES;
+            std::fprintf(f, "frame %2d  pid %d  proc %d  %s page %d\n", fr, proc_owner[proc], proc,
+                         code ? "instr" : "data", code ? index : index - NUM_INSTR_PAGES);
+        } else if (!freePages[fr] && count == 0) {
+            std::fprintf(f, "frame %2d  free\n", fr);
+        } else {
+            std::fprintf(f, "frame %2d  INCONSISTENT: %s, but in %d page table entr%s\n", fr,
+                         freePages[fr] ? "allocated" : "free", count, count == 1 ? "y" : "ies");
+            problems++;
+        }
+    }
+    std::fprintf(f, "page tables in frame 0 (entry = frame, - = not mapped):\n");
+    for (int p = 0; p < NP; p++) {
+        if (PTBR[p] < 0) { std::fprintf(f, "proc %d  idle (PTBR -1)\n", p); continue; }
+        std::fprintf(f, "proc %d  PTBR %-3d pid %d (%s):", p, PTBR[p], proc_owner[p],
+                     tasks[proc_owner[p] - 1].prog.name.c_str());
+        for (int i = 0; i < NUM_LOGICAL_PAGES; i++) {
+            int fr = memory[PTBR[p] + i];
+            bool code = i < NUM_INSTR_PAGES;
+            std::fprintf(f, " %c%d=", code ? 'I' : 'D', code ? i : i - NUM_INSTR_PAGES);
+            if (fr) std::fprintf(f, "%d", fr);
+            else std::fprintf(f, "-");
+        }
+        std::fprintf(f, "\n");
+    }
+    std::fprintf(f, "free frames: %d of %d\n", free_page_count(), NUM_PHYSICAL_PAGES - 1);
+    if (problems) std::fprintf(f, "check: %d PROBLEM(S)\n", problems);
+    else std::fprintf(f, "check: OK (every used frame is in exactly one page table, no free frame is mapped)\n");
+    return problems;
 }
 
+/* EXT e15: append a snapshot to memory_map.txt (emptied by os_init). */
+static void write_memory_map(const std::string &title) {
+    FILE *f = std::fopen(MEMORY_MAP_FILE, "a");
+    if (!f) return;
+    dump_memory_map(f, title);
+    std::fprintf(f, "\n");
+    std::fclose(f);
+    map_changed = false;
+}
