+/* EXT e18: context switch helpers. save_context() copies every per-processor register of p
+ * into a PCB; restore_context() loads a PCB back, including PTBR (the task's page table). */
+void save_context(int p, PCB &c) {
+    std::memcpy(c.x, Register[p], sizeof c.x);
+    std::memcpy(c.v, VRegister[p], sizeof c.v);
+    c.pc = PC[p];
+    c.flagN = FlagN[p]; c.flagZ = FlagZ[p]; c.flagC = FlagC[p]; c.flagV = FlagV[p];
+    c.ptbr = PTBR[p];
+    c.end_of_simulation = end_of_simulation[p];
+    c.failed = failed[p];
+    c.steps = steps[p];
+    std::memcpy(c.exec_count, exec_count[p], sizeof c.exec_count);
+    c.data_high = data_high[p];
 }
 
+void restore_context(int p, const PCB &c) {
+    std::memcpy(Register[p], c.x, sizeof c.x);
+    std::memcpy(VRegister[p], c.v, sizeof c.v);
+    PC[p] = c.pc;
+    FlagN[p] = c.flagN; FlagZ[p] = c.flagZ; FlagC[p] = c.flagC; FlagV[p] = c.flagV;
+    PTBR[p] = c.ptbr;
+    end_of_simulation[p] = c.end_of_simulation;
+    failed[p] = c.failed;
+    steps[p] = c.steps;
+    std::memcpy(exec_count[p], c.exec_count, sizeof c.exec_count);
+    data_high[p] = c.data_high;
+}
