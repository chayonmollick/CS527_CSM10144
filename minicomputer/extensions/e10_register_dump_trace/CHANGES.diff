+/* EXT e10: <program>_<pid>.regs - PC, flags and every register that is not zero at the end
+ * of the task (x registers in decimal and hex, vector registers lane 0..7). */
+static std::string write_register_file(int p, const Task &t, int &nonzero_x, int &nonzero_v) {
+    std::string name = t.prog.name + "_" + std::to_string(t.pid) + ".regs";
+    nonzero_x = nonzero_v = 0;
+    for (int r = 0; r < NUM_XREGS; r++) nonzero_x += Register[p][r] != 0;
+    for (int r = 0; r < NUM_VREGS; r++)
+        for (int i = 0; i < VLEN; i++)
+            if (VRegister[p][r][i]) { nonzero_v++; break; }
+    FILE *f = std::fopen(name.c_str(), "w");
+    if (!f) return "(could not write " + name + ")";
+    std::fprintf(f, "Registers of %s (pid %d) on processor %d after %ld instructions (%s)\n", t.prog.name.c_str(),
+                 t.pid, p, steps[p], failed[p] ? "stopped with an error" : "finished");
+    std::fprintf(f, "PC %d (0x%08X) = instruction %d\n", PC[p], (unsigned)PC[p], PC[p] / 4);
+    std::fprintf(f, "flags N=%d Z=%d C=%d V=%d\n", FlagN[p], FlagZ[p], FlagC[p], FlagV[p]);
+    std::fprintf(f, "x registers that are not zero: %d\n", nonzero_x);
+    for (int r = 0; r < NUM_XREGS; r++)
+        if (Register[p][r])
+            std::fprintf(f, "  x%-3d = %11d  0x%08X\n", r, Register[p][r], (unsigned)Register[p][r]);
+    std::fprintf(f, "vector registers that are not zero: %d\n", nonzero_v);
+    for (int r = 0; r < NUM_VREGS; r++) {
+        bool zero = true;
+        for (int i = 0; i < VLEN; i++) zero = zero && VRegister[p][r][i] == 0;
+        if (zero) continue;
+        std::fprintf(f, "  v%-3d =", r);
+        for (int i = 0; i < VLEN; i++) std::fprintf(f, " %d", VRegister[p][r][i]);
+        std::fprintf(f, "\n");
+    }
+    std::fclose(f);
+    return name;
+}
