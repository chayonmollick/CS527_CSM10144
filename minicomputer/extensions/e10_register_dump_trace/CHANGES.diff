+/* EXT e10: one line of the -T trace for the instruction just executed:
+ * step, instruction index, its 4 bytes, disassembly, and what it changed. */
+static void write_trace_line(int p) {
+    std::string result;
+    char buf[64];
+    int *x = Register[p];
+    int addr = 0;
+    if (failed[p]) {                                    /* nothing was written */
+        result = "error: the task stopped here";
+    } else switch (opcode) {
+    case OP_HALT:
+        result = "end of task";
+        break;
+    case OP_ADD: case OP_SUB: case OP_ADDI: case OP_SUBI:         /* xD = ... (+ - also set NZCV) */
+    case OP_MUL: case OP_DIV: case OP_MULI: case OP_DIVI:
+    case OP_MOV: case OP_MOVC: case OP_LOAD: case OP_LOADC:
+        std::snprintf(buf, sizeof buf, "x%d = %d (0x%08X)", dest, x[dest], (unsigned)x[dest]);
+        result = buf;
+        if (opcode == OP_ADD || opcode == OP_SUB || opcode == OP_ADDI || opcode == OP_SUBI) {
+            std::snprintf(buf, sizeof buf, "  NZCV=%d%d%d%d", FlagN[p], FlagZ[p], FlagC[p], FlagV[p]);
+            result += buf;
         }
+        break;
+    case OP_STORE: case OP_STOREC:                                 /* [address] = xS */
+        addr = opcode == OP_STORE ? x[dest] : dest;
+        result = "[" + std::to_string(addr) + "] = " + std::to_string(x[src2]);
+        break;
+    case OP_VSTORE: case OP_VSTOREC:                               /* 8 words from address */
+        addr = opcode == OP_VSTORE ? x[dest] : dest;
+        result = "[" + std::to_string(addr) + ".." + std::to_string(addr + 4 * VLEN - 1) + "] = v" + std::to_string(src2);
+        break;
+    case OP_PRINT:
+        std::snprintf(buf, sizeof buf, "log: x%d : %08X", src2, (unsigned)x[src2]);
+        result = buf;
+        break;
+    default:
+        if (opcode >= OP_BRANCH && opcode < OP_BRANCH + NUM_CONDITIONS)   /* flags unchanged by a branch */
+            result = condition_holds(p, opcode - OP_BRANCH) ? "taken -> instruction " + std::to_string(PC[p] / 4)
+                                                            : "not taken";
+        else {                                                     /* vector op or load: vD = 8 lanes */
+            result = "v" + std::to_string(dest) + " =";
+            for (int i = 0; i < VLEN; i++) result += " " + std::to_string(VRegister[p][dest][i]);
+        }
     }
+    std::fprintf(trace_fd[p], "%6ld %5d  %02X %02X %02X %02X  %-18s %s\n", steps[p], instr_pc / 4,
+                 opcode, dest, src1, src2, disassemble(opcode, dest, src1, src2).c_str(), result.c_str());
 }
 
