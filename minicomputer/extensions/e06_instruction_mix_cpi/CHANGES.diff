+/* ---- EXT e06: instruction mix and cycle estimate ----
+ * Every executed instruction is put in one class. Estimated cycles of a task =
+ * sum over the classes of (count * latency); a taken branch costs LAT_BRANCH +
+ * LAT_TAKEN_PENALTY. CPI = cycles / instructions. Change a latency and rebuild.
+ */
+#define LAT_ALU             1   /* EXT e06: + - and moves (register or constant) */
+#define LAT_MUL             3   /* EXT e06 */
+#define LAT_DIV             10  /* EXT e06 */
+#define LAT_LOAD            3   /* EXT e06: xD = [xA] / [c] */
+#define LAT_STORE           3   /* EXT e06: [xA] / [c] = xS */
+#define LAT_BRANCH          1   /* EXT e06: every B<cond>, taken or not */
+#define LAT_TAKEN_PENALTY   2   /* EXT e06: extra cycles when the branch is taken */
+#define LAT_VECTOR          4   /* EXT e06: vector + - * */
+#define LAT_VMEM            8   /* EXT e06: vector load / store (8 words) */
+#define LAT_PRINT           1   /* EXT e06 */
+#define LAT_HALT            1   /* EXT e06 */
+
+enum InstrClass {               /* EXT e06: one row each in the .stats file, in this order */
+    CLS_ALU, CLS_MUL, CLS_DIV, CLS_LOAD, CLS_STORE, CLS_BRANCH_TAKEN, CLS_BRANCH_NOT_TAKEN,
+    CLS_VECTOR, CLS_VMEM, CLS_PRINT, CLS_HALT, NUM_CLASSES
+};
+
