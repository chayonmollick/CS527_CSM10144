+/* EXT e06: <program>_<pid>.stats - instruction mix, estimated cycles and CPI of the task.
+ * Returns the file name; instructions and cycles are returned for the summary line. */
+static std::string write_stats_file(int p, const Task &t, long &instructions, long &cycles) {
+    instructions = cycles = 0;
+    for (int c = 0; c < NUM_CLASSES; c++) {
+        instructions += class_count[p][c];
+        cycles += class_count[p][c] * CLASS_LATENCY[c];
+    }
+    std::string name = t.prog.name + "_" + std::to_string(t.pid) + ".stats";
+    FILE *f = std::fopen(name.c_str(), "w");
+    if (!f) return "(could not write " + name + ")";
+    std::fprintf(f, "Instruction mix of %s (pid %d)\n", t.prog.name.c_str(), t.pid);
+    std::fprintf(f, "%-18s %8s %8s %8s %8s\n", "class", "count", "%instr", "latency", "cycles");
+    for (int c = 0; c < NUM_CLASSES; c++)
+        std::fprintf(f, "%-18s %8ld %7.2f%% %8d %8ld\n", CLASS_NAME[c], class_count[p][c],
+                     instructions ? 100.0 * class_count[p][c] / instructions : 0.0,
+                     CLASS_LATENCY[c], class_count[p][c] * CLASS_LATENCY[c]);
+    std::fprintf(f, "%-18s %8ld %8s %8s %8ld\n", "total", instructions, "100.00%", "", cycles);
+    std::fprintf(f, "CPI = %ld cycles / %ld instructions = %.2f\n", cycles, instructions,
+                 instructions ? (double)cycles / instructions : 0.0);
+    std::fprintf(f, "(branch_taken latency = %d + %d taken penalty)\n", LAT_BRANCH, LAT_TAKEN_PENALTY);
+    std::fclose(f);
+    return name;
+}
